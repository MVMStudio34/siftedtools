---
import AffiliateDisclosure from "./AffiliateDisclosure.astro";
import { getLangFromUrl, useTranslations, getSlug } from "../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const s = (key) => getSlug(lang as any, key);
const base = `/${lang}`;
const year = new Date().getFullYear();
const links = [
  { href: `${base}/${s("methodology")}/`, label: t("footer.method") },
  { href: `${base}/${s("barometer")}/`, label: t("footer.barometer") },
  { href: `${base}/${s("about")}/`, label: t("footer.about") },
  { href: `${base}/${s("legal")}/`, label: t("footer.legal") },
  { href: `${base}/${s("privacy")}/`, label: t("footer.privacy") },
];
---
<footer class="site-footer">
  <div class="wrap">
    <div class="disclosure-slot"><AffiliateDisclosure /></div>
    <div class="foot-grid">
      <div class="foot-brand">
        <span class="ui name">{t("brand.name")}</span>
        <p class="note">{t("footer.rights")}</p>
      </div>
      <nav class="foot-links ui" aria-label={t("nav.footer")}>
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
    </div>
    <a class="pys-badge" href="https://postyourstartup.co/startup/siftedtools?ref=badge" target="_blank" rel="noopener">
      <img src="https://postyourstartup.co/api/badge/siftedtools?theme=light" alt="Featured on PostYourStartup" width="53" height="14" loading="lazy" />
    </a>
    <a class="pys-badge" href="https://www.toolpilot.ai" target="_blank" rel="noopener">
      <img src="/badges/toolpilot.png" alt="Featured on ToolPilot" width="53" height="12" loading="lazy" />
    </a>
    <a class="pys-badge" href="https://launchbuff.com" target="_blank" rel="noopener noreferrer">
      <img src="https://launchbuff.com/badge-featured-dark.svg" alt="Featured on LaunchBuff" width="53" height="17" loading="lazy" />
    </a>
    <a class="pys-badge" href="https://supalaun.ch/projects/siftedtools" target="_blank" rel="noopener noreferrer">
      <img src="https://r2.direasy-multi-tenant.focusapps.app/uploads/616d0b1a-3979-4b8c-94d1-b4f1fedd3ead/1783046782431/gqxqtqpde6k/top3-dark.svg" alt="Supa Launch Top 3 Daily Winner" width="53" height="17" loading="lazy" />
    </a>
    <p class="copy note">© {year} {t("brand.name")}</p>
  </div>
</footer>

<style>
  .site-footer{border-top:1px solid var(--mesh);background:var(--card);padding:48px 0 36px;margin-top:40px}
  .disclosure-slot{margin-bottom:36px}
  .foot-grid{display:flex;justify-content:space-between;gap:32px;flex-wrap:wrap;align-items:flex-start}
  .foot-brand .name{font-size:18px;font-weight:700}
  .foot-brand .note{margin-top:8px;max-width:34ch}
  .foot-links{display:flex;flex-wrap:wrap;gap:18px;font-size:14px}
  .foot-links a{color:var(--slate)}
  .foot-links a:hover{color:var(--ink)}
  .pys-badge{display:inline-block;margin-top:16px}
  .copy{margin-top:30px}
</style>
