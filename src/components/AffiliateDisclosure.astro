---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
const { compact = false } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
---
<aside class="disclosure" role="note">
  <span class="tag">{t("disclosure.tag")}</span>
  <p>{t("disclosure.short")}</p>
</aside>

<style>
  /* Divulgation d'affiliation : conforme (obligation légale) mais discrète.
     Une seule ligne fine sous le titre, sans encadré ni fond, pour ne pas alourdir la page. */
  .disclosure{
    display:flex;
    gap:8px;
    align-items:baseline;
    padding:0;
    margin:6px 0 4px;
    border:none;
    background:none;
  }
  .disclosure .tag{
    flex:none;
    font-family:"Space Mono",monospace;
    font-size:9.5px;
    letter-spacing:.08em;
    text-transform:uppercase;
    color:var(--gold);
    opacity:.85;
    padding-top:1px;
  }
  .disclosure p{
    font-size:12px;
    color:var(--muted, #9A9B9F);
    line-height:1.5;
    font-family:"Space Grotesk",sans-serif;
    margin:0;
  }
  @media (max-width:520px){
    .disclosure{flex-direction:column;gap:2px}
  }
</style>
