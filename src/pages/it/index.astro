---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EmailCaptureInline from "../../components/EmailCaptureInline.astro";
import AuthorBio from "../../components/AuthorBio.astro";
import { organization, webPage, buildGraph } from "../../lib/schema";

const site = "https://siftedtools.com";
const url = `${site}/it/`;
const updated = "2026-07-01";

const schema = [
  buildGraph(
    organization(),
    webPage({
      url,
      title: "Strumenti IA per e-commerce: il verdetto, non la lista",
      description:
        "Comparatore indipendente dei migliori strumenti IA per negozi WooCommerce, Shopify e DTC. Testati su negozi reali, classificati per merito.",
      updatedAt: new Date(updated),
      lang: "it",
    })
  ),
];
---
<BaseLayout
  title="Strumenti IA per e-commerce: il verdetto, non la lista | SiftedTools"
  description="Comparatore indipendente dei migliori strumenti IA per negozi WooCommerce, Shopify e DTC. Testati su negozi reali, classificati per merito."
  canonical={url}
  alternates={[
    { lang: "it", href: `${site}/it/` },
    { lang: "fr", href: `${site}/fr/` },
    { lang: "en", href: `${site}/en/` },
    { lang: "es", href: `${site}/es/` },
    { lang: "de", href: `${site}/de/` },
  ]}
  updatedAt={updated}
  schema={schema}
>
  <div class="home">
    <section class="hero">
      <p class="kicker ui">Comparatore indipendente di strumenti IA per e-commerce</p>
      <h1>Lo strumento giusto.<br /><em>Non la lista pi&ugrave; lunga.</em></h1>
      <p class="subtitle">Testiamo gli strumenti IA su negozi reali, non da una pagina prodotto. Verdetto chiaro, metodologia documentata, zero bias. Per WooCommerce e Shopify.</p>
    </section>

    <section class="coming">
      <h2 class="ui">Confronti in arrivo</h2>
      <p>I nostri confronti in italiano sono in preparazione. Nel frattempo, iscriviti per ricevere il Barometro GEO appena esce.</p>
      <EmailCaptureInline />
    </section>

    <div class="author-slot"><AuthorBio updatedAt={updated} /></div>
  </div>
</BaseLayout>

<style>
  .home{max-width:760px;margin:0 auto;padding:48px 24px}
  .hero{text-align:center;margin-bottom:56px}
  .kicker{font-size:13px;letter-spacing:0.08em;text-transform:uppercase;color:var(--gold);margin-bottom:20px}
  .hero h1{font-size:clamp(36px,6vw,56px);line-height:1.05;letter-spacing:-0.02em}
  .hero em{font-style:italic;color:var(--gold)}
  .subtitle{font-size:clamp(17px,2.5vw,20px);color:var(--slate);max-width:52ch;margin:20px auto 0;line-height:1.5}
  .coming{margin:48px 0}
  .coming h2{font-size:clamp(22px,3vw,28px);margin-bottom:8px}
  .coming p{color:var(--slate);margin-bottom:24px;max-width:60ch}
  .author-slot{margin:48px 0}
</style>
