---
// Page racine neutre avec sélecteur de langue + détection douce côté client.
// x-default du hreflang pointe ici. Chaque version linguistique reste indépendante et crawlable.
const site = "https://siftedtools.com";

const languages = [
  { code: "fr", label: "Français",   country: "France",         href: "/fr/" },
  { code: "en", label: "English",    country: "UK / US",        href: "/en/" },
  { code: "es", label: "Español",    country: "España",         href: "/es/" },
  { code: "de", label: "Deutsch",    country: "Deutschland",    href: "/de/" },
  { code: "it", label: "Italiano",   country: "Italia",         href: "/it/" },
  { code: "pt", label: "Português",  country: "Portugal",       href: "/pt/" },
  { code: "nl", label: "Nederlands", country: "Nederland",      href: "/nl/" },
];

const title = "SiftedTools — AI tools for e-commerce, sifted and verdict-first";
const description = "Independent comparator of the best AI tools for e-commerce, in 7 languages. Tested on real stores, ranked on merit. Choose your language.";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={`${site}/`} />

  <!-- hreflang : 7 langues + x-default sur cette page racine -->
  {languages.map((l) => (
    <link rel="alternate" hreflang={l.code} href={`${site}${l.href}`} />
  ))}
  <link rel="alternate" hreflang="x-default" href={`${site}/`} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={`${site}/`} />

  <style>
    :root{
      --ink:#16171D; --porcelain:#F4F5F2; --slate:#6B6C73; --mesh:#C9CAC4;
      --gold:#B17C2E; --gold-light:#D4A04F; --card:#FFFFFF; --radius-lg:6px;
    }
    *{box-sizing:border-box;margin:0;padding:0}
    body{
      font-family:'Space Grotesk',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
      background:var(--porcelain);color:var(--ink);
      min-height:100vh;display:flex;flex-direction:column;
      align-items:center;justify-content:center;padding:32px 24px;
    }
    .brand{
      font-family:'Newsreader',Georgia,serif;font-weight:600;
      font-size:clamp(28px,5vw,40px);letter-spacing:-0.02em;margin-bottom:8px;
    }
    .brand .dot{color:var(--gold)}
    .tagline{
      font-size:15px;color:var(--slate);text-align:center;max-width:44ch;
      margin-bottom:8px;line-height:1.5;
    }
    .tagline-2{
      font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.1em;
      text-transform:uppercase;color:var(--gold);margin-bottom:36px;
    }
    .suggested{
      font-size:13px;color:var(--slate);margin-bottom:16px;min-height:20px;
      text-align:center;
    }
    .suggested a{color:var(--ink);font-weight:600;text-decoration:underline;text-decoration-color:var(--gold);text-underline-offset:3px}
    .langs{
      display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));
      gap:12px;width:100%;max-width:620px;
    }
    .lang{
      background:var(--card);border:1px solid var(--mesh);border-radius:var(--radius-lg);
      padding:18px 20px;text-decoration:none;color:var(--ink);
      display:flex;flex-direction:column;gap:2px;
      transition:border-color .15s,transform .15s;position:relative;
    }
    .lang::before{
      content:'';position:absolute;top:-1px;left:20px;right:20px;height:2px;
      background:var(--gold);opacity:0;transition:opacity .15s;
    }
    .lang:hover{border-color:var(--gold-light);transform:translateY(-2px)}
    .lang:hover::before{opacity:1}
    .lang-label{font-size:17px;font-weight:600}
    .lang-country{font-size:13px;color:var(--slate)}
    .foot{margin-top:40px;font-size:12px;color:var(--slate);text-align:center}
    @media (prefers-reduced-motion:reduce){.lang:hover{transform:none}}
  </style>
</head>
<body>
  <div class="brand">Sifted<span class="dot">Tools</span></div>
  <p class="tagline">Independent comparator of the best AI tools for e-commerce. Tested on real stores, ranked on merit.</p>
  <p class="tagline-2">The verdict, not the list</p>

  <p class="suggested" id="suggested" data-prefix-en="Detected language:" hidden></p>

  <nav class="langs" aria-label="Choose your language">
    {languages.map((l) => (
      <a class="lang" href={l.href} hreflang={l.code} lang={l.code}>
        <span class="lang-label">{l.label}</span>
        <span class="lang-country">{l.country}</span>
      </a>
    ))}
  </nav>

  <p class="foot">© 2026 SiftedTools · MVM Studio</p>

  <script is:inline>
    // Détection douce : on met en avant la langue du navigateur, sans rediriger.
    (function(){
      var supported = ["fr","en","es","de","it","pt","nl"];
      var names = {fr:"Français",en:"English",es:"Español",de:"Deutsch",it:"Italiano",pt:"Português",nl:"Nederlands"};
      var prompts = {
        fr:"Langue détectée :", en:"Detected language:", es:"Idioma detectado:",
        de:"Erkannte Sprache:", it:"Lingua rilevata:", pt:"Idioma detetado:", nl:"Gedetecteerde taal:"
      };
      var nav = (navigator.languages && navigator.languages[0]) || navigator.language || "en";
      var code = nav.slice(0,2).toLowerCase();
      if (supported.indexOf(code) === -1) return; // pas de suggestion si non supporté
      var el = document.getElementById("suggested");
      if (!el) return;
      var label = prompts[code] || "Detected language:";
      el.innerHTML = label + ' <a href="/' + code + '/">' + (names[code] || code) + ' →</a>';
      el.hidden = false;
    })();
  </script>
</body>
</html>
