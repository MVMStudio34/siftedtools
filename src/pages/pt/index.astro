---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MethodologyBox from "../../components/MethodologyBox.astro";
import EmailCaptureInline from "../../components/EmailCaptureInline.astro";
import AuthorBio from "../../components/AuthorBio.astro";
import { useTranslations } from "../../i18n/utils";
import { organization, webPage, buildGraph } from "../../lib/schema";

const site = "https://siftedtools.com";
const url = `${site}/pt/`;
const updated = "2026-07-03";
const t = useTranslations("pt");

const schema = [
  buildGraph(
    organization(),
    webPage({ url, title: 'Ferramentas IA para e-commerce: o veredicto, não a lista | SiftedTools', description: 'Comparador independente das melhores ferramentas IA para lojas Shopify, WooCommerce e DTC. Testadas em lojas reais, classificadas por mérito.', updatedAt: new Date(updated), lang: "pt" })
  ),
];

const picks = [
  { cat: "Apoio ao cliente", tool: "Gorgias", line: "Para lojas que escalam o apoio sem aumentar a equipa.", href: "/pt/melhores-ferramentas-ia-ecommerce/" },
  { cat: "Fichas de produto", tool: "Writesonic", line: "Redação em massa e multilingue, pensada para catálogos grandes.", href: "/pt/melhores-ferramentas-ia-ecommerce/" },
  { cat: "Avaliações Shopify", tool: "Loox", line: "A app de avaliações visuais mais completa para marcas DTC e lifestyle.", href: "/pt/melhores-ferramentas-ia-ecommerce/" },
];

const categories = [
  { t: "Apoio ao cliente", d: "Chatbots e helpdesk IA", href: "/pt/melhores-ferramentas-ia-ecommerce/" },
  { t: "Fichas de produto", d: "Redação em grande escala", href: "/pt/melhores-ferramentas-ia-ecommerce/" },
  { t: "Email marketing", d: "Sequências e segmentação", href: "/pt/melhores-ferramentas-ia-ecommerce/" },
  { t: "SEO e conteúdo", d: "Artigos e páginas otimizadas", href: "/pt/melhores-ferramentas-ia-ecommerce/" },
  { t: "Criativos publicitários", d: "Visuais e ganchos de anúncios", href: "/pt/melhores-ferramentas-ia-ecommerce/" },
  { t: "Visibilidade IA", d: "Ser citado pelos LLM", href: "/pt/melhores-ferramentas-ia-ecommerce/" },
];
---
<BaseLayout
  title='Ferramentas IA para e-commerce: o veredicto, não a lista | SiftedTools'
  description='Comparador independente das melhores ferramentas IA para lojas Shopify, WooCommerce e DTC. Testadas em lojas reais, classificadas por mérito.'
  canonical={url}
  alternates={[
    { lang: "pt", href: `${site}/pt/` },
    { lang: "fr", href: `${site}/fr/` },
    { lang: "en", href: `${site}/en/` },
    { lang: "es", href: `${site}/es/` },
    { lang: "de", href: `${site}/de/` },
    { lang: "it", href: `${site}/it/` },
    { lang: "nl", href: `${site}/nl/` },
  ]}
  updatedAt={updated}
  schema={schema}
>
  <section class="hero">
    <div class="wrap">
      <span class="eyebrow">{t("home.heroEyebrow")}</span>
      <h1>O veredicto,<br />não a lista.</h1>
      <p class="lede">Centenas de ferramentas IA prometem impulsionar a tua loja. Testamo-las em lojas reais, ficamos com um punhado e dizemos-te qual escolher para a tua necessidade. Escrito para quem gere mesmo uma loja, em Portugal e no Brasil.</p>
      <div class="hero-cta">
        <a class="btn btn-quiz" href="/pt/barometro-geo/">{t("home.heroCtaBaro")}</a>
        <a class="btn btn-ghost" href="/pt/comparativos/">{t("home.heroCtaCompare")}</a>
      </div>
    </div>

    <div class="wrap">
      <div class="sieve-label">{t("home.sieveLabel")}</div>
      <div class="picks">
        {picks.map((p, i) => (
          <a class="pick" href={p.href}>
            <span class="mono pick-rank">{String(i + 1).padStart(2, "0")}</span>
            <div class="pick-body">
              <div class="pick-head">
                <strong class="ui">{p.tool}</strong>
                <span class="tag">{t("home.bestFor")} · {p.cat}</span>
              </div>
              <p>{p.line}</p>
            </div>
            <span class="pick-arrow ui" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="sieve" role="presentation"></div>

  <section class="cats">
    <div class="wrap">
      <div class="cats-head">
        <span class="eyebrow">{t("home.catsEyebrow")}</span>
        <h2 class="ui">{t("home.catsTitle")}</h2>
      </div>
      <div class="cat-grid">
        {categories.map((c) => (
          <a class="cat" href={c.href}>
            <h3 class="ui">{c.t}</h3>
            <p>{c.d}</p>
            <span class="cat-link ui">{t("home.viewComparison")}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="method-section">
    <div class="wrap"><MethodologyBox /></div>
  </section>

  <section class="baro">
    <div class="wrap baro-inner">
      <div class="baro-copy">
        <span class="eyebrow">{t("home.baroEyebrow")}</span>
        <h2 class="ui">{t("home.baroTitle")}</h2>
        <p>{t("home.baroText")}</p>
        <a class="btn btn-ghost" href="/pt/barometro-geo/">{t("home.baroCta")}</a>
      </div>
      <div class="baro-viz" aria-hidden="true">
        <div class="baro-row"><span class="ui">{t("home.baroCited4")}</span><span class="bar b4"></span></div>
        <div class="baro-row"><span class="ui">{t("home.baroCited3")}</span><span class="bar b3"></span></div>
        <div class="baro-row"><span class="ui">{t("home.baroCited1")}</span><span class="bar b1"></span></div>
        <div class="baro-row dim"><span class="ui">{t("home.baroCited0")}</span><span class="bar b0"></span></div>
      </div>
    </div>
  </section>

  <section class="email-section">
    <div class="wrap"><EmailCaptureInline /></div>
  </section>

  <section class="author-section">
    <div class="wrap"><AuthorBio updatedAt={updated} /></div>
  </section>
</BaseLayout>

<style>
  /* HERO */
  .hero{padding:72px 0 40px}
  .hero h1{font-size:clamp(44px,7vw,76px);line-height:1.02;margin:18px 0 0}
  .lede{font-size:20px;color:var(--slate);max-width:60ch;margin:22px 0 0;line-height:1.55}
  .hero-cta{display:flex;gap:12px;flex-wrap:wrap;margin:30px 0 56px}

  .sieve-label{margin-bottom:18px}
  .picks{display:flex;flex-direction:column;gap:12px}
  .pick{display:flex;align-items:center;gap:18px;background:var(--card);border:1px solid var(--mesh);border-radius:var(--radius-lg);padding:20px 22px;transition:border-color .15s,transform .15s}
  .pick:hover{border-color:var(--gold-light);transform:translateX(3px)}
  .pick-rank{color:var(--gold);font-size:15px}
  .pick-body{flex:1}
  .pick-head{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:5px}
  .pick-head strong{font-size:19px}
  .pick-body p{font-size:15px;color:var(--slate)}
  .pick-arrow{color:var(--gold);font-size:20px}

  /* CATEGORIES */
  .cats-head{margin-bottom:26px}
  .cats-head h2{font-size:30px;margin-top:6px}
  .cat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
  .cat{background:var(--card);border:1px solid var(--mesh);border-radius:var(--radius-lg);padding:24px 22px;transition:border-color .15s,transform .15s}
  .cat:hover{border-color:var(--gold-light);transform:translateY(-2px)}
  .cat h3{font-size:19px;margin-bottom:6px}
  .cat p{font-size:14.5px;color:var(--slate);margin-bottom:16px}
  .cat-link{font-size:14px;color:var(--gold);font-weight:600}
  .cat-soon{opacity:.7}
  .cat-soon .cat-link{color:var(--slate)}

  /* BAROMETRE */
  .baro{background:var(--ink)}
  .baro-inner{display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:center}
  .baro-copy .eyebrow{color:var(--gold-light)}
  .baro-copy h2{color:var(--porcelain);font-size:30px;margin:8px 0 14px}
  .baro-copy p{color:#C7C8CD;font-size:16px;line-height:1.6;max-width:48ch;margin-bottom:24px}
  .baro-copy .btn-ghost{color:var(--porcelain);border-color:#3A3B43}
  .baro-copy .btn-ghost:hover{background:var(--porcelain);color:var(--ink)}
  .baro-viz{display:flex;flex-direction:column;gap:14px}
  .baro-row{display:flex;align-items:center;gap:14px;font-size:13px;color:#C7C8CD}
  .baro-row .ui{flex:0 0 130px}
  .bar{height:14px;border-radius:7px;background:var(--gold)}
  .bar.b4{width:100%}
  .bar.b3{width:74%}
  .bar.b1{width:32%}
  .bar.b0{width:8%;background:#3A3B43}
  .baro-row.dim{color:var(--muted)}

  @media (max-width:820px){
    .cat-grid{grid-template-columns:1fr 1fr}
    .baro-inner{grid-template-columns:1fr;gap:32px}
  }
  @media (max-width:480px){
    .cat-grid{grid-template-columns:1fr}
    .pick-arrow{display:none}
  }
  @media (prefers-reduced-motion:reduce){
    .pick:hover,.cat:hover{transform:none}
  }
</style>
